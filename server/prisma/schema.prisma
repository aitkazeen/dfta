generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Currency {
  code     String @id @db.Char(3) // "USD" | "EUR" | "RUB" | "KZT"
  name     String
  symbol   String // "$", "€", "₽", "₸"
  isActive Boolean @default(true) @map("is_active")

  basePairs  CurrencyPair[] @relation("BaseCurrency")
  quotePairs CurrencyPair[] @relation("QuoteCurrency")

  @@map("currency")
}

// id — человекочитаемый слаг ("USD-KZT"), не число: мобильный клиент уже
// использует именно эту строку как id пары (mobile/src/types.ts), а роут
// GET /v1/pairs/:id/quote (roadmap §6) резолвится без слоя трансляции.
model CurrencyPair {
  id          String  @id @db.VarChar(15) // "USD-KZT"
  baseCode    String  @map("base_code") @db.Char(3)
  quoteCode   String  @map("quote_code") @db.Char(3)
  displayName String  @map("display_name") // "USD/KZT"
  isActive    Boolean @default(true) @map("is_active")
  priority    Int     @default(0)

  base    Currency @relation("BaseCurrency", fields: [baseCode], references: [code])
  quote   Currency @relation("QuoteCurrency", fields: [quoteCode], references: [code])
  candles Candle[]
  indicators IndicatorValue[]
  forecasts Forecast[]
  newsLinks NewsPairLink[]

  @@unique([baseCode, quoteCode])
  @@map("currency_pair")
}


model Candle {
  pairId    String   @map("pair_id")
  ts        DateTime
  timeframe String
  open      Decimal  @db.Decimal(18, 6)
  high      Decimal  @db.Decimal(18, 6)
  low       Decimal  @db.Decimal(18, 6)
  close     Decimal  @db.Decimal(18, 6)
  source    String

  pair CurrencyPair @relation(fields: [pairId], references: [id])

  @@id([pairId, timeframe, ts])
  @@map("candle")
}

model IndicatorValue {
  pairId    String  @map("pair_id")
  ts        DateTime
  timeframe String
  name      String
  value     Decimal @db.Decimal(18, 6)

  pair CurrencyPair @relation(fields: [pairId], references: [id])

  @@id([pairId, timeframe, ts, name])
  @@map("indicator_value")
}

model Forecast {
  id            String   @id @default(cuid())
  pairId        String   @map("pair_id")
  createdAt     DateTime @default(now()) @map("created_at")
  horizon       String   // '24h' | '7d' — строкой, как Candle.timeframe, без Prisma-enum
  direction     String   // 'up' | 'down' | 'flat'
  confidence    Decimal  @db.Decimal(18, 6)
  targetLow     Decimal  @map("target_low")  @db.Decimal(18, 6)
  targetHigh    Decimal  @map("target_high") @db.Decimal(18, 6)
  engineVersion String   @map("engine_version")
  features      Json
  explanation   String?  // LLM-текст, пока не считается (Этап 4 позже) — nullable
  drivers       Json?    // топ-3 причины от LLM, тоже пока не считается

  pair    CurrencyPair    @relation(fields: [pairId], references: [id])
  outcome ForecastOutcome?

  @@map("forecast")
}

model ForecastOutcome {
  forecastId  String   @id @map("forecast_id")
  resolvedAt  DateTime @map("resolved_at")
  actualClose Decimal  @db.Decimal(18, 6) @map("actual_close")
  wasCorrect  Boolean  @map("was_correct")
  absError    Decimal  @db.Decimal(18, 6) @map("abs_error")

  forecast Forecast @relation(fields: [forecastId], references: [id])

  @@map("forecast_outcome")
}

model NewsArticle {
  id           String   @id @default(cuid())
  externalId   String   @unique @map("external_id") // sha256(url) — ключ дедупа
  source       String   // "nbk-rss" | "marketaux"
  url          String
  title        String
  summary      String?
  publishedAt  DateTime @map("published_at")
  lang         String
  rawSentiment Decimal? @map("raw_sentiment") @db.Decimal(4, 3) // сентимент сущности от Marketaux, null для RSS-статей
  ourSentiment Decimal? @map("our_sentiment") @db.Decimal(4, 3) // LLM-классификация, null если rawSentiment уже есть или классификация не удалась
  fetchedAt    DateTime @default(now()) @map("fetched_at")

  pairLinks NewsPairLink[]
  entities  NewsEntity[]

  @@map("news_article")
}

model NewsPairLink {
  articleId   String  @map("article_id")
  pairId      String  @map("pair_id")
  relevance   Decimal @db.Decimal(4, 3)
  impactScore Decimal @map("impact_score") @db.Decimal(4, 3)

  article NewsArticle  @relation(fields: [articleId], references: [id])
  pair    CurrencyPair @relation(fields: [pairId], references: [id])

  @@id([articleId, pairId])
  @@map("news_pair_link")
}

model NewsEntity {
  articleId   String @map("article_id")
  entityType  String @map("entity_type")  // "currency" | "country" | "institution"
  entityValue String @map("entity_value")

  article NewsArticle @relation(fields: [articleId], references: [id])

  @@id([articleId, entityType, entityValue])
  @@map("news_entity")
}

// authProvider всегда 'apple' сейчас — Google подключаем в этом же этапе, но
// первый релиз iOS-only (Android отложен), поэтому Google Sign-In пока не
// протестирован живьём. Модель уже провайдер-агностичная, чтобы не переделывать.
model AppUser {
  id           String   @id @default(cuid())
  authProvider String   @map("auth_provider") // 'apple' | 'google'
  authSub      String   @map("auth_sub")
  email        String?
  createdAt    DateTime @default(now()) @map("created_at")
  tz           String   @default("Asia/Almaty")
  locale       String   @default("ru")
  plan         String   @default("free")

  deviceTokens DeviceToken[]

  @@unique([authProvider, authSub])
  @@map("app_user")
}

// platform хранит 'ios' | 'android' с самого начала, хотя Android-релиза
// пока нет — сама модель ничего не знает про то, что мы не собираем Android,
// это чисто вопрос EAS-профилей сборки, не схемы.
model DeviceToken {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  platform   String   // 'ios' | 'android'
  token      String   @unique
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user AppUser @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("device_token")
}