{
  "name": "dfta-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "fx:compare": "tsx --env-file-if-exists=.env scripts/compare-fx-providers.ts",
    "fx:export-dataset": "tsx --env-file-if-exists=.env scripts/export-nbk-dataset.ts",
    "marketaux:test": "tsx --env-file-if-exists=.env scripts/marketaux-test.ts",
    "fx:backfill-dataset": "tsx --env-file-if-exists=.env scripts/backfill-nbk-candles.ts",
    "forecast:backtest": "tsx --env-file-if-exists=.env scripts/backtest-forecast.ts",
    "forecast:tune": "tsx --env-file-if-exists=.env scripts/tune-weights.ts",
    "forecast:tune-weights": "tsx --env-file-if-exists=.env scripts/tune-forecast-weights.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@prisma/client": "^6.2.1",
    "bullmq": "^6.0.9",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.10",
    "technicalindicators": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.7",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
