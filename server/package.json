{
  "name": "dfta-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "fx:compare": "tsx --env-file-if-exists=.env scripts/compare-fx-providers.ts",
    "fx:export-dataset": "tsx --env-file-if-exists=.env scripts/export-nbk-dataset.ts",
    "marketaux:test": "tsx --env-file-if-exists=.env scripts/marketaux-test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bullmq": "^6.0.9",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
