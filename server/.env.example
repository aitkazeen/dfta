# Скопируй в .env, если запускаешь сервер напрямую (npm run dev без Docker).
# Обрати внимание: здесь localhost, а не db — потому что процесс
# идёт с твоей машины через проброшенный порт 5432.
DATABASE_URL=postgres://app:secret@localhost:5432/app
PORT=3000

# Этап 0 (docs/architecture-roadmap.md §0, §3.1) — сверка FX-провайдеров.
# Нужен хотя бы один ключ, чтобы npm run fx:compare было с чем сравнивать.
# Получить: forexrateapi.com (free tier без карты) / unirateapi.com (free tier).
FOREXRATEAPI_KEY=
UNIRATEAPI_KEY=
MARKETAUXAPI_KEY=