# Скопируй в .env, если запускаешь сервер напрямую (npm run dev без Docker).
# Обрати внимание: здесь localhost, а не db — потому что процесс
# идёт с твоей машины через проброшенный порт 5432.
DATABASE_URL=postgres://app:secret@localhost:5432/app
PORT=3000

# Этап 0 (docs/architecture-roadmap.md §0, §3.1) — сверка FX-провайдеров.
# Нужен хотя бы один ключ, чтобы npm run fx:compare было с чем сравнивать.
# Получить: forexrateapi.com (free tier без карты) / unirateapi.com (free tier).
FOREXRATEAPI_KEY=
UNIRATEAPI_KEY=
MARKETAUXAPI_KEY=
REDIS_URL=redis://localhost:6379

# Этап 4 — LLM-объяснение прогноза (правило 3 CLAUDE.md: только текст,
# не сам прогноз). Нужен хотя бы один из двух ключей, иначе воркер просто не
# заполняет explanation/drivers (createExplainer возвращает no-op) — не
# обязательно для локального запуска. При обоих заданных выигрывает Gemini.
# GEMINI_API_KEY — постоянный бесплатный тариф. Получить: aistudio.google.com (без карты).
GEMINI_API_KEY=
# ANTHROPIC_API_KEY — платно (после разового триал-кредита нужен баланс). Получить: console.anthropic.com
ANTHROPIC_API_KEY=